{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "oxfmt --write \"resources/js/**/*.{ts,tsx}\" \"!resources/js/types/sprite-icons.ts\"",
        "format:check": "oxfmt --check \"resources/js/**/*.{ts,tsx}\" \"!resources/js/types/sprite-icons.ts\"",
        "lint": "oxlint resources/js --fix",
        "lint:check": "oxlint resources/js",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "oxfmt": "^0.54.0",
        "oxlint": "^1.68.0",
        "playwright": "^1.60.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/echo-react": "^2.3.7",
        "@laravel/passkeys": "^0.2.0",
        "@lattice-php/lattice": "^0.10.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "concurrently": "^10.0.3",
        "laravel-echo": "^2.3.7",
        "laravel-vite-plugin": "^3.0.0",
        "pusher-js": "^8.5.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.0"
    }
}
