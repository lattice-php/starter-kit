{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "oxfmt --write \"resources/js/**/*.{ts,tsx}\" \"!resources/js/types/sprite-icons.ts\"",
        "format:check": "oxfmt --check \"resources/js/**/*.{ts,tsx}\" \"!resources/js/types/sprite-icons.ts\"",
        "lint": "oxlint resources/js --fix",
        "lint:check": "oxlint resources/js",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@types/node": "^24.13.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.79.0",
        "playwright": "^1.62.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.0",
        "@inertiajs/vite": "^3.7.0",
        "@laravel/echo-react": "^2.4.0",
        "@laravel/passkeys": "^0.4.0",
        "@lattice-php/core": "^0.59.0",
        "@lattice-php/lattice": "^0.59.0",
        "@lattice-php/ui": "^0.59.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "concurrently": "^10.0.5",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.2.0",
        "pusher-js": "^8.6.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.2.1"
    }
}
